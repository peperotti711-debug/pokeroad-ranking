rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /profiles/{uid} {
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','avatar','accountId','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 30 && request.resource.data.accountId is string;
   allow update: if request.auth != null && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar']) && request.resource.data.name is string && request.resource.data.name.size() <= 30;
   allow delete: if false;
  }
  match /posts/{postId} {
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid','image','moves','category','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.moves is int && request.resource.data.moves >= 0 && request.resource.data.moves <= 9999 && request.resource.data.category in ['混合編成','リレーラッシュ編成','その他'] && request.resource.data.image is string && request.resource.data.createdAt == request.time;
   allow update: if false;
   allow delete: if request.auth != null && request.auth.token.admin == true;
  }
 }
}
